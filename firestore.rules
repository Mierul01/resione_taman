rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOfPark(parkName) {
      return isSignedIn() && myProfile().role == 'admin' && myProfile().parkName == parkName;
    }

    function isCommitteeOfPark(parkName) {
      return isSignedIn()
        && myProfile().role in ['admin', 'ajk', 'treasurer', 'chairman']
        && myProfile().parkName == parkName;
    }

    function isTreasuryOfPark(parkName) {
      return isSignedIn()
        && myProfile().role in ['admin', 'treasurer', 'chairman']
        && myProfile().parkName == parkName;
    }

    function isChairmanOfPark(parkName) {
      return isSignedIn()
        && myProfile().role == 'chairman'
        && myProfile().parkName == parkName;
    }

    // A chairman can hand out committee roles (ajk/treasurer/resident) to
    // members who don't already hold admin/chairman, but can't touch the
    // admin or chairman assignment itself — only the admin can appoint a
    // chairman or another admin — and can't change anything on the profile
    // besides the role field.
    function isChairmanRoleHandoff() {
      return isChairmanOfPark(resource.data.parkName)
        && resource.data.role in ['resident', 'ajk', 'treasurer']
        && request.resource.data.role in ['resident', 'ajk', 'treasurer']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }

    // One document per account, keyed by Firebase Auth uid.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn()
        && (
          // Residents can freely edit their own profile, but never their
          // own role field — role changes must go through an admin or the
          // chairman hand-off below, never self-service.
          (request.auth.uid == userId && request.resource.data.role == resource.data.role)
          || isAdminOfPark(resource.data.parkName)
          || isChairmanRoleHandoff()
        );
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Self-reported fee/charity payments. Never editable or deletable once
    // recorded (this is an honor-system ledger, not a real payment gateway).
    match /paymentRecords/{recordId} {
      allow read: if isSignedIn()
        && (resource.data.userEmail == request.auth.token.email
            || myProfile().parkName == resource.data.parkName);
      allow create: if isSignedIn() && request.resource.data.userEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // Park programs/events. Anyone signed in can read; only that park's
    // committee (AJK/treasurer/chairman/admin) can create, edit or remove one.
    match /programs/{programId} {
      allow read: if isSignedIn();
      allow create: if isCommitteeOfPark(request.resource.data.parkName);
      allow update, delete: if isCommitteeOfPark(resource.data.parkName) || isAdminOfPark(resource.data.parkName);
    }

    // One bank-account-details doc per park (doc id = encodeURIComponent(parkName)).
    match /bankAccounts/{parkId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myProfile().role in ['admin', 'treasurer', 'chairman'];
    }

    // Fee item names/amounts per park (doc id = encodeURIComponent(parkName), and
    // the doc itself carries a plain parkName field so this rule can check it
    // without needing to decode the id). Anyone in the park can read them to
    // pay; only that park's treasury roles can edit.
    match /feeSettings/{parkId} {
      allow read: if isSignedIn();
      allow write: if isTreasuryOfPark(request.resource.data.parkName);
    }

    // Public directory of registered parks (doc id = encodeURIComponent(parkName)),
    // holding the name plus a lowercased copy for prefix search and its
    // state/district/city. Read publicly so the Register screen's park
    // search works before the visitor has an account; writes require auth
    // since a park is only added once someone actually registers into it.
    match /parks/{parkId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // One doc per physical house (doc id = `${parkId}_${normalizedHouseNo}`),
    // holding just enough to say "this house is already registered" and who
    // owns it. Read publicly for the same pre-account reason as parks above
    // (Register needs to show "already registered, contact <owner>" before
    // the visitor exists as a user). A household can only ever be created by
    // the person claiming ownership of it (email must match their own
    // account), and never reassigned or deleted from the client — moving a
    // resident to a different house is a future admin-mediated flow.
    match /households/{householdId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerEmail == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
